# Copy to .env and fill in locally. .env is git-ignored. Never commit real values.
# ENTSO-E Transparency Platform API token.
ENTSOE_API_KEY=
# Google Cloud project registered for Earth Engine (noncommercial).
EE_PROJECT=
# Copernicus Climate Data Store API key (live HDD controls, deviation D15).
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=
# NASA Earthdata login (VIIRS snow fallback).
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
